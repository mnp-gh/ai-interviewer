    "openai": "^4.103.0",
    "unpdf": "^1.9.0",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
