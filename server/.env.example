# MongoDB connection string (Atlas free tier in production).
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interviewer

# AI providers. Each model in src/ai/models.ts is offered only when its provider's key is set.
# Groq is the default and is needed for parsing unless PARSE_MODEL points elsewhere.
GROQ_API_KEY=          # https://console.groq.com/keys
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys (free tier may train on inputs)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier may train on inputs; not for EEA/UK/CH users)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys (free models: small daily cap shared by all users)

# Web research for role briefings: https://app.tavily.com (free, ~1,000 searches/month, no card).
# Without it, interviews still work; the review step just skips the briefing.
TAVILY_API_KEY=

# Optional: model id used to parse resumes and job descriptions (default groq:openai/gpt-oss-120b).
# PARSE_MODEL=

# Bot check (Cloudflare Turnstile): https://dash.cloudflare.com -> Turnstile -> add your domain.
# Set the matching site key as VITE_TURNSTILE_SITE_KEY for the client. Unset = checks skipped (local dev).
# Local testing with Cloudflare's always-pass test pair: 1x0000000000000000000000000000000AA (secret) / 1x00000000000000000000AA (site).
TURNSTILE_SECRET_KEY=

# Admin usage page (/admin): a random token of 32+ characters, e.g. `openssl rand -hex 32`.
# Empty (or shorter) = the page and its API are off.
ADMIN_TOKEN=

# Usage budgets (defaults shown). Daily AI budgets count tokens (prompt + completion);
# keep DAILY_TOKENS under your providers' free daily token quotas.
# DAILY_TOKENS=1500000
# DAILY_SEARCHES=30
# DAILY_SEARCHES_PER_IP=9
# DAILY_TOKENS_PER_CANDIDATE=150000
# DAILY_TOKENS_PER_IP=300000
# AI_CALLS_PER_MINUTE=20
# DAILY_INTERVIEWS_PER_CANDIDATE=5
# DAILY_INTERVIEWS_PER_IP=5
# ACCOUNT_ACTIONS_PER_MINUTE=10

# Set to true to pause new setups and interviews (interviews in progress can finish).
# MAINTENANCE_MODE=false

# Local dev port (Vite proxies /api to it).
PORT=8080

# Production only (deploy/docker-compose.yml sets these; leave unset locally):
# HOST=0.0.0.0                      # listen address (default 127.0.0.1)
# PUBLIC_ORIGIN=https://example.com # the site's origin: passkeys belong to it, and cookies become Secure
# CLIENT_IP_HEADER=x-real-ip        # header the reverse proxy overwrites with the client IP
