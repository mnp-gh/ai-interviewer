{
  "name": "ai-interviewer",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter client build && pnpm --filter e2e e2e"
  }
}
