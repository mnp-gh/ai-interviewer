  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink pill for the main action on a surface (Start, Submit answer, Continue).",
      "html": "<button class=\"ds-btn-primary\">Submit answer</button>",
      "css": ".ds-btn-primary{font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif;background:#17181b;color:#fff;border:none;border-radius:999px;padding:11px 26px;font-size:1rem;font-weight:700;letter-spacing:0;cursor:pointer;transition:background-color 250ms cubic-bezier(0.4,0,0.2,1)}.ds-btn-primary:hover{background:#2e2f33}.ds-btn-primary:focus-visible{outline:2px solid #2f5bd3;outline-offset:2px}.ds-btn-primary:disabled{background:rgba(0,0,0,0.12);color:rgba(0,0,0,0.26)}"
    },
    {
      "name": "Outlined Button",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Secondary pill bordered in currentColor (End interview, Answer again).",
      "html": "<button class=\"ds-btn-outlined\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M14.4 6l-.24-1.2c-.09-.46-.5-.8-.98-.8H6c-.55 0-1 .45-1 1v15c0 .55.45 1 1 1s1-.45 1-1v-6h5.6l.24 1.2c.09.47.5.8.98.8H19c.55 0 1-.45 1-1V7c0-.55-.45-1-1-1z\"/></svg>End interview</button>",
      "css": ".ds-btn-outlined{font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;background:transparent;color:#17181b;border:1px solid currentColor;border-radius:999px;padding:3px 12px;font-size:0.8125rem;font-weight:700;cursor:pointer;transition:background-color 250ms}.ds-btn-outlined:hover{background:rgba(23,24,27,0.04)}.ds-btn-outlined:focus-visible{outline:2px solid #2f5bd3;outline-offset:2px}"
    },
    {
