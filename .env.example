# Docker Compose settings for running the containers from a checkout (copy to .env next to docker-compose.yml).
# The server's own variables live in server/.env (see server/.env.example). On the server, CI writes both
# files from the GitHub production environment.

# Public hostname the site is served on (the one in deploy/nginx.conf). Without a domain, use sslip.io:
# a VM at 203.0.113.9 is 203-0-113-9.sslip.io. Passkeys are tied to this name.
SITE_ADDRESS=

# Cloudflare Turnstile site key, baked into the client at build time; rebuild after changing it.
VITE_TURNSTILE_SITE_KEY=
